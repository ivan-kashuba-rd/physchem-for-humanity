---
import '../styles/global.css';
const lang = Astro.url.pathname.includes('/ru/') ? 'ru' : 'en';
const isTool = Astro.url.pathname.includes('/tools/equilibrium');
const title = isTool ? (lang === 'ru' ? 'Калькулятор термодинамического равновесия | PhysChem for Humanity' : 'Thermodynamic Equilibrium Calculator | PhysChem for Humanity') : (lang === 'ru' ? 'PhysChem for Humanity — открытая физическая химия' : 'PhysChem for Humanity');
const description = lang === 'ru' ? 'Открытые знания и вычислительные инструменты по физической химии.' : 'Open physical chemistry knowledge and computational tools for human progress.';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = `${base}${lang}/`;
const path = Astro.url.pathname;
const other = path.includes('/en/') ? path.replace('/en/', '/ru/') : path.replace('/ru/', '/en/');
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = abs(path);
const enHref = abs(path.replace('/ru/', '/en/'));
const ruHref = abs(path.replace('/en/', '/ru/'));
const otherLabel = lang === 'ru' ? 'EN' : 'RU';
const otherTitle = lang === 'ru' ? 'Switch to English' : 'Переключить на русский';
const navLabel = lang === 'ru' ? 'Основная навигация' : 'Main navigation';
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f3eedf"/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="en" href={enHref}/><link rel="alternate" hreflang="ru" href={ruHref}/><link rel="alternate" hreflang="x-default" href={enHref}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'}/><title>{title}</title></head>
<body><a class="skip" href="#content">{lang==='ru'?'К содержанию':'Skip to content'}</a><header><a class="brand" href={home}>PhysChem <em>for Humanity</em></a><nav aria-label={navLabel}><a href={`${home}#mission`}>{lang==='ru'?'Миссия':'Mission'}</a><a href={`${home}tools/equilibrium`}>{lang==='ru'?'Инструменты':'Tools'}</a><a href={`${home}#knowledge`}>{lang==='ru'?'Знания':'Knowledge'}</a></nav><a class="lang" href={other} lang={lang==='ru'?'en':'ru'} hreflang={lang==='ru'?'en':'ru'} title={otherTitle} aria-label={otherTitle}>{otherLabel}</a></header><div id="content"><slot/></div><footer><strong>PhysChem for Humanity</strong><span>{lang==='ru'?'Открытые знания и вычислительные инструменты для прогресса человечества.':'Open knowledge and computational tools for human progress.'}</span><small>MIT · CC BY 4.0 · 2026</small></footer></body></html>
